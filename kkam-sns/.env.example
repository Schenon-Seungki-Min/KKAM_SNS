# KKAM_SNS 환경변수 설정
# 이 파일을 .env.local로 복사하여 실제 값 입력

# ===== 트렌드 API 키 =====

# Google Trends (SerpAPI 사용)
# 발급: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# 네이버 개발자 센터
# 발급: https://developers.naver.com/
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# YouTube Data API v3
# 발급: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key

# PubMed API (선택사항 - 없어도 동작함)
# 발급: https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_API_KEY=your_pubmed_api_key

# ===== AI API 키 (2단계 이후) =====

# Claude API (Anthropic)
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (DALL-E 이미지 생성용)
# 발급: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key

# ===== 앱 설정 =====
NEXT_PUBLIC_APP_NAME=KKAM_SNS
NEXT_PUBLIC_APP_URL=http://localhost:3000
